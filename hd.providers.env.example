# Copy this file to hd.providers.env locally, enter only the providers you intend to use,
# and run HD with --provider-env hd.providers.env. Never commit the copied file.
# Blank values are ignored. Do not wrap values in quotes.

HOLYFITRA_AI_PROVIDER=

OPENAI_API_KEY=
OPENAI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Verified OpenAI-compatible providers.
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
HOLYFITRA_CEREBRAS_MODEL=gpt-oss-120b
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
HOLYFITRA_GROQ_MODEL=llama-3.3-70b-versatile

# Cohere uses its v2 Chat API directly.
COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.com
COHERE_MODEL=command-a-plus-05-2026
