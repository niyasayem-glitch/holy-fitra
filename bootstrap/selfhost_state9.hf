  var parameter_count: i32 = 0
  var has_parameter: bool = false
  while parameter_index < close {
    let parameter_character: i32 = hf_string_byte32(source, parameter_index)
    if parameter_character == 44 {
      if !has_parameter { return -1 }
      parameter_count = parameter_count + 1
      has_parameter = false
    } else {
      if !is_space(parameter_character) { has_parameter = true }
    }
    parameter_index = parameter_index + 1
  }
  if has_parameter { parameter_count = parameter_count + 1 }
  return parameter_count
}

