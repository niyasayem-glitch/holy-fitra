fn ast_child_count(node_id: i32, child_parents: dyn<i32>) -> i32 {
  var edge_index: i32 = 0
  var result: i32 = 0
  while edge_index < hf_dyn_i32_len32(child_parents) {
    if hf_dyn_i32_get32(child_parents, edge_index) == node_id { result = result + 1 }
    edge_index = edge_index + 1
  }
  return result
}

fn ast_child_at(node_id: i32, ordinal: i32, child_parents: dyn<i32>, child_nodes: dyn<i32>) -> i32 {
  var edge_index: i32 = 0
  var seen: i32 = 0
  while edge_index < hf_dyn_i32_len32(child_parents) {
    if hf_dyn_i32_get32(child_parents, edge_index) == node_id {
      if seen == ordinal { return hf_dyn_i32_get32(child_nodes, edge_index) }
      seen = seen + 1
    }
    edge_index = edge_index + 1
  }
  return -1
}

fn find_single_import(module_id: i32, import_from: dyn<i32>) -> i32 {
  var import_index: i32 = 0
  var result: i32 = -1
  while import_index < hf_dyn_i32_len32(import_from) {
    if hf_dyn_i32_get32(import_from, import_index) == module_id {
      if result >= 0 { return -2 }
      result = import_index
    }
    import_index = import_index + 1
  }
  return result
}

fn validate_imported_calls(module_filter: i32, module_hashes: dyn<i32>, module_lengths: dyn<i32>, import_from: dyn<i32>, import_target_hashes: dyn<i32>, import_target_lengths: dyn<i32>, import_symbol_hashes: dyn<i32>, import_symbol_lengths: dyn<i32>, export_modules: dyn<i32>, export_hashes: dyn<i32>, export_lengths: dyn<i32>, export_public: dyn<i32>, export_type_ids: dyn<i32>, export_param_counts: dyn<i32>, export_param_bases: dyn<i32>, export_param_types: dyn<i32>, ast_kinds: dyn<i32>, ast_modules: dyn<i32>, ast_starts: dyn<i32>, ast_ends: dyn<i32>, ast_symbols: dyn<i32>, ast_types: dyn<i32>, child_parents: dyn<i32>, child_nodes: dyn<i32>, diagnostic_codes: dyn<i32>, diagnostic_modules: dyn<i32>) -> bool {
  var node_index: i32 = 0
  var valid: bool = true
  while node_index < hf_dyn_i32_len32(ast_kinds) {
    if hf_dyn_i32_get32(ast_kinds, node_index) == 11 {
