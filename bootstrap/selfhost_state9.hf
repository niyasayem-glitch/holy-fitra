fn load_module(path: string, source_id: i32, module_hashes: dyn<i32>, module_lengths: dyn<i32>, module_sources: dyn<i32>, states: dyn<i32>, import_from: dyn<i32>, import_target_hashes: dyn<i32>, import_target_lengths: dyn<i32>, import_symbol_hashes: dyn<i32>, import_symbol_lengths: dyn<i32>, export_modules: dyn<i32>, export_hashes: dyn<i32>, export_lengths: dyn<i32>, export_public: dyn<i32>, export_type_ids: dyn<i32>, export_param_counts: dyn<i32>, export_param_bases: dyn<i32>, export_param_types: dyn<i32>, ast_kinds: dyn<i32>, ast_modules: dyn<i32>, ast_starts: dyn<i32>, ast_ends: dyn<i32>, ast_symbols: dyn<i32>, ast_types: dyn<i32>, ast_counts: dyn<i32>, ast_roots: dyn<i32>, ast_source_hashes: dyn<i32>, ast_source_bytes: dyn<i32>, child_modules: dyn<i32>, child_parents: dyn<i32>, child_nodes: dyn<i32>, child_bases: dyn<i32>, child_counts: dyn<i32>) -> i32 {
