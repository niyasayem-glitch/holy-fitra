  if state == 3 { return false }
  hf_dyn_i32_set32(states, module_id, 1)
  var import_index: i32 = 0
  var resolved: bool = true
  let import_count: i32 = hf_dyn_i32_len32(import_from)
  while import_index < import_count {
    if hf_dyn_i32_get32(import_from, import_index) == module_id {
      let target_module: i32 = find_module(module_hashes, module_lengths, hf_dyn_i32_get32(import_target_hashes, import_index), hf_dyn_i32_get32(import_target_lengths, import_index))
      if target_module < 0 {
        add_diagnostic(4001, module_id, diagnostic_codes, diagnostic_modules)
        resolved = false
      } else {
        if !resolve_module(target_module, states, module_hashes, module_lengths, import_from, import_target_hashes, import_target_lengths, import_symbol_hashes, import_symbol_lengths, export_modules, export_hashes, export_lengths, export_public, diagnostic_codes, diagnostic_modules) { resolved = false }
        let export_result: i32 = find_export(export_modules, export_hashes, export_lengths, export_public, target_module, hf_dyn_i32_get32(import_symbol_hashes, import_index), hf_dyn_i32_get32(import_symbol_lengths, import_index))
        if export_result == -2 {
          add_diagnostic(4004, module_id, diagnostic_codes, diagnostic_modules)
          resolved = false
        } else {
          if export_result < 0 {
            add_diagnostic(4003, module_id, diagnostic_codes, diagnostic_modules)
            resolved = false
          }
        }
      }
    }
    import_index = import_index + 1
  }
  if resolved {
    hf_dyn_i32_set32(states, module_id, 2)
  } else {
    hf_dyn_i32_set32(states, module_id, 3)
  }
  return resolved
}

fn graph_snapshot(module_hashes: dyn<i32>, module_lengths: dyn<i32>, module_sources: dyn<i32>, states: dyn<i32>, import_from: dyn<i32>, import_target_hashes: dyn<i32>, import_target_lengths: dyn<i32>, import_symbol_hashes: dyn<i32>, diagnostic_codes: dyn<i32>, diagnostic_modules: dyn<i32>) -> string {
  let buffer: buf = hf_buf_new(8192)
  var index: i32 = 0
  let module_count: i32 = hf_dyn_i32_len32(module_hashes)
  while index < module_count {
    hf_buf_append_i32(buffer, index)
    hf_buf_append_str(buffer, ":")
    hf_buf_append_i32(buffer, hf_dyn_i32_get32(module_hashes, index))
    hf_buf_append_str(buffer, ":")
    hf_buf_append_i32(buffer, hf_dyn_i32_get32(module_lengths, index))
    hf_buf_append_str(buffer, ":")
    hf_buf_append_i32(buffer, hf_dyn_i32_get32(module_sources, index))
    hf_buf_append_str(buffer, ":")
    hf_buf_append_i32(buffer, hf_dyn_i32_get32(states, index))
    hf_buf_append_str(buffer, ";")
    index = index + 1
  }
  hf_buf_append_str(buffer, "|")
  index = 0
  let import_count: i32 = hf_dyn_i32_len32(import_from)
  while index < import_count {
    hf_buf_append_i32(buffer, hf_dyn_i32_get32(import_from, index))
    hf_buf_append_str(buffer, "->")
    hf_buf_append_i32(buffer, hf_dyn_i32_get32(import_target_hashes, index))
    hf_buf_append_str(buffer, ":")
    hf_buf_append_i32(buffer, hf_dyn_i32_get32(import_target_lengths, index))
    hf_buf_append_str(buffer, ".")
    hf_buf_append_i32(buffer, hf_dyn_i32_get32(import_symbol_hashes, index))
    hf_buf_append_str(buffer, ";")
    index = index + 1
  }
  hf_buf_append_str(buffer, "|")
  index = 0
  let diagnostic_count: i32 = hf_dyn_i32_len32(diagnostic_codes)
  while index < diagnostic_count {
    hf_buf_append_i32(buffer, hf_dyn_i32_get32(diagnostic_codes, index))
    hf_buf_append_str(buffer, "@")
    hf_buf_append_i32(buffer, hf_dyn_i32_get32(diagnostic_modules, index))
    hf_buf_append_str(buffer, ";")
    index = index + 1
  }
  let result: string = hf_buf_finish(buffer)
  hf_buf_free(buffer)
  return result
}

