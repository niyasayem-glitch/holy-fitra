// Imported State-2 parser core, namespaced for State-9 call retention.
fn p9_is_space(ch: i32) -> bool {
  return ch == 32 || ch == 9 || ch == 10 || ch == 13
}

fn p9_is_digit(ch: i32) -> bool {
  return ch >= 48 && ch <= 57
}

fn p9_is_ident_start(ch: i32) -> bool {
  return (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95
}

fn p9_is_ident_continue(ch: i32) -> bool {
  return p9_is_ident_start(ch) || p9_is_digit(ch)
}

fn p9_keyword(source: string, start: i32, length: i32, word: string, kind: i32) -> bool {
  let word_size: i32 = hf_string_len32(word)
  if start + word_size > length {
    return false
  } else {
    if start + word_size < length && p9_is_ident_continue(hf_string_byte32(source, start + word_size)) {
      return false
    } else {
      var word_index: i32 = 0
      var equal: bool = true
      while word_index < word_size {
        if hf_string_byte32(source, start + word_index) != hf_string_byte32(word, word_index) {
          equal = false
        }
        word_index = word_index + 1
      }
      return equal
    }
  }
}

fn p9_keyword_kind(source: string, start: i32, length: i32) -> i32 {
  if p9_keyword(source, start, length, "module", 10) { return 10 }
  if p9_keyword(source, start, length, "struct", 11) { return 11 }
  if p9_keyword(source, start, length, "fn", 12) { return 12 }
  if p9_keyword(source, start, length, "return", 13) { return 13 }
  if p9_keyword(source, start, length, "if", 14) { return 14 }
  if p9_keyword(source, start, length, "else", 15) { return 15 }
  if p9_keyword(source, start, length, "while", 16) { return 16 }
  if p9_keyword(source, start, length, "true", 17) { return 17 }
  if p9_keyword(source, start, length, "false", 18) { return 18 }
  if p9_keyword(source, start, length, "let", 19) { return 19 }
  if p9_keyword(source, start, length, "var", 20) { return 20 }
  if p9_keyword(source, start, length, "i32", 21) { return 21 }
  if p9_keyword(source, start, length, "i64", 22) { return 22 }
  if p9_keyword(source, start, length, "bool", 23) { return 23 }
  if p9_keyword(source, start, length, "void", 24) { return 24 }
  if p9_keyword(source, start, length, "string", 25) { return 25 }
  if p9_keyword(source, start, length, "pub", 27) { return 27 }
  if p9_keyword(source, start, length, "dyn", 26) { return 26 }
  return 100
}

fn p9_keyword_length(kind: i32) -> i32 {
  if kind == 10 || kind == 11 || kind == 13 || kind == 25 { return 6 }
  if kind == 12 || kind == 14 { return 2 }
  if kind == 15 { return 4 }
  if kind == 16 { return 5 }
  if kind == 17 { return 4 }
  if kind == 18 { return 5 }
  if kind == 19 || kind == 20 || kind == 21 || kind == 22 || kind == 26 { return 3 }
  if kind == 23 || kind == 24 { return 4 }
  if kind == 27 { return 3 }
  return 0
}

fn p9_single_kind(ch: i32) -> i32 {
  if ch == 58 { return 40 }
  if ch == 59 { return 41 }
  if ch == 40 { return 42 }
  if ch == 41 { return 43 }
  if ch == 123 { return 44 }
  if ch == 125 { return 45 }
  if ch == 44 { return 48 }
  if ch == 61 { return 60 }
  if ch == 43 { return 61 }
  if ch == 45 { return 62 }
  if ch == 42 { return 63 }
  if ch == 47 { return 64 }
  if ch == 60 { return 50 }
  if ch == 62 { return 51 }
  return -1
}

fn p9_push_token(kinds: dyn<i32>, starts: dyn<i32>, lengths: dyn<i32>, kind: i32, start: i32, length: i32) -> bool {
