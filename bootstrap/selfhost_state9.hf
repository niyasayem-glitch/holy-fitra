// State-7 typed HIR records: kind 1=resolved module, kind 2=resolved imported symbol.
fn hir_add(hir_kinds: dyn<i32>, hir_modules: dyn<i32>, hir_symbols: dyn<i32>, hir_types: dyn<i32>, kind: i32, module_id: i32, symbol_id: i32, type_id: i32) -> bool {
  if kind < 1 || kind > 2 || module_id < 0 || type_id < 0 { return false }
  if hf_dyn_i32_len32(hir_kinds) >= 128 { return false }
  let kind_ok: bool = hf_dyn_i32_push(hir_kinds, kind)
  let module_ok: bool = hf_dyn_i32_push(hir_modules, module_id)
  let symbol_ok: bool = hf_dyn_i32_push(hir_symbols, symbol_id)
  let type_ok: bool = hf_dyn_i32_push(hir_types, type_id)
  return kind_ok && module_ok && symbol_ok && type_ok
}

fn lower_hir(module_hashes: dyn<i32>, module_lengths: dyn<i32>, states: dyn<i32>, import_from: dyn<i32>, import_target_hashes: dyn<i32>, import_target_lengths: dyn<i32>, import_symbol_hashes: dyn<i32>, import_symbol_lengths: dyn<i32>, export_modules: dyn<i32>, export_hashes: dyn<i32>, export_lengths: dyn<i32>, export_public: dyn<i32>, export_type_ids: dyn<i32>, hir_kinds: dyn<i32>, hir_modules: dyn<i32>, hir_symbols: dyn<i32>, hir_types: dyn<i32>) -> bool {
  var module_index: i32 = 0
  let module_count: i32 = hf_dyn_i32_len32(module_hashes)
  var lowering_ok: bool = true
  while module_index < module_count {
    if hf_dyn_i32_get32(states, module_index) == 2 {
      lowering_ok = lowering_ok && hir_add(hir_kinds, hir_modules, hir_symbols, hir_types, 1, module_index, -1, 0)
      var import_index: i32 = 0
      let import_count: i32 = hf_dyn_i32_len32(import_from)
      while import_index < import_count {
        if hf_dyn_i32_get32(import_from, import_index) == module_index {
          let target_module: i32 = find_module(module_hashes, module_lengths, hf_dyn_i32_get32(import_target_hashes, import_index), hf_dyn_i32_get32(import_target_lengths, import_index))
          if target_module >= 0 && target_module < module_count && hf_dyn_i32_get32(states, target_module) == 2 {
            let imported_symbol: i32 = find_export(export_modules, export_hashes, export_lengths, export_public, target_module, hf_dyn_i32_get32(import_symbol_hashes, import_index), hf_dyn_i32_get32(import_symbol_lengths, import_index))
            if imported_symbol >= 0 {
              lowering_ok = lowering_ok && hir_add(hir_kinds, hir_modules, hir_symbols, hir_types, 2, module_index, imported_symbol, hf_dyn_i32_get32(export_type_ids, imported_symbol))
            } else {
              lowering_ok = false
            }
          } else {
            lowering_ok = false
          }
        }
        import_index = import_index + 1
      }
    }
    module_index = module_index + 1
  }
  return lowering_ok
}

fn hir_snapshot(hir_kinds: dyn<i32>, hir_modules: dyn<i32>, hir_symbols: dyn<i32>, hir_types: dyn<i32>) -> string {
  let buffer: buf = hf_buf_new(4096)
  var snapshot_index: i32 = 0
  let snapshot_count: i32 = hf_dyn_i32_len32(hir_kinds)
  while snapshot_index < snapshot_count {
    hf_buf_append_i32(buffer, snapshot_index)
    hf_buf_append_str(buffer, ":")
    hf_buf_append_i32(buffer, hf_dyn_i32_get32(hir_kinds, snapshot_index))
    hf_buf_append_str(buffer, ":")
    hf_buf_append_i32(buffer, hf_dyn_i32_get32(hir_modules, snapshot_index))
    hf_buf_append_str(buffer, ":")
    hf_buf_append_i32(buffer, hf_dyn_i32_get32(hir_symbols, snapshot_index))
    hf_buf_append_str(buffer, ":")
    hf_buf_append_i32(buffer, hf_dyn_i32_get32(hir_types, snapshot_index))
    hf_buf_append_str(buffer, ";")
    snapshot_index = snapshot_index + 1
  }
  let result: string = hf_buf_finish(buffer)
  hf_buf_free(buffer)
  return result
}

fn child_snapshot(child_modules: dyn<i32>, child_parents: dyn<i32>, child_nodes: dyn<i32>, child_bases: dyn<i32>, child_counts: dyn<i32>) -> string {
  let buffer: buf = hf_buf_new(4096)
  var index: i32 = 0
  while index < hf_dyn_i32_len32(child_modules) {
    hf_buf_append_i32(buffer, hf_dyn_i32_get32(child_modules, index))
    hf_buf_append_str(buffer, ":")
    hf_buf_append_i32(buffer, hf_dyn_i32_get32(child_parents, index))
    hf_buf_append_str(buffer, ">")
    hf_buf_append_i32(buffer, hf_dyn_i32_get32(child_nodes, index))
    hf_buf_append_str(buffer, ";")
    index = index + 1
  }
  hf_buf_append_str(buffer, "|")
  index = 0
  while index < hf_dyn_i32_len32(child_bases) {
    hf_buf_append_i32(buffer, hf_dyn_i32_get32(child_bases, index))
    hf_buf_append_str(buffer, "/")
    hf_buf_append_i32(buffer, hf_dyn_i32_get32(child_counts, index))
    hf_buf_append_str(buffer, ";")
    index = index + 1
  }
  let result: string = hf_buf_finish(buffer)
  hf_buf_free(buffer)
  return result
}

fn bool_value(value: bool) -> i32 {
  if value { return 1 }
  return 0
}

