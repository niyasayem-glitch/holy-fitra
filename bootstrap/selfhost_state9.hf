      var import_index: i32 = -1
      if callee_node >= 0 {
        if hf_dyn_i32_get32(ast_kinds, callee_node) == 7 { import_index = find_single_import(module_id, import_from) }
      }
      if import_index < 0 {
        add_diagnostic(5003, module_id, diagnostic_codes, diagnostic_modules)
        valid = false
      } else {
        let target_module: i32 = find_module(module_hashes, module_lengths, hf_dyn_i32_get32(import_target_hashes, import_index), hf_dyn_i32_get32(import_target_lengths, import_index))
        var export_index: i32 = -1
        if target_module >= 0 {
          export_index = find_export(export_modules, export_hashes, export_lengths, export_public, target_module, hf_dyn_i32_get32(import_symbol_hashes, import_index), hf_dyn_i32_get32(import_symbol_lengths, import_index))
        }
        if target_module < 0 {
          add_diagnostic(5003, module_id, diagnostic_codes, diagnostic_modules)
          valid = false
        } else {
          if export_index < 0 {
            add_diagnostic(5003, module_id, diagnostic_codes, diagnostic_modules)
            valid = false
          } else {
          let actual_count: i32 = ast_child_count(node_index, child_parents) - 1
          let expected_count: i32 = hf_dyn_i32_get32(export_param_counts, export_index)
          var call_valid: bool = actual_count == expected_count
          var argument_index: i32 = 0
          var compare_count: i32 = actual_count
          if expected_count < compare_count { compare_count = expected_count }
          while argument_index < compare_count {
            let argument_node: i32 = ast_child_at(node_index, argument_index + 1, child_parents, child_nodes)
            var actual_type: i32 = -1
            if argument_node >= 0 { actual_type = hf_dyn_i32_get32(ast_types, argument_node) }
            let expected_type: i32 = hf_dyn_i32_get32(export_param_types, hf_dyn_i32_get32(export_param_bases, export_index) + argument_index)
            if actual_type != expected_type { call_valid = false }
            argument_index = argument_index + 1
          }
          if actual_count != expected_count {
            add_diagnostic(5001, module_id, diagnostic_codes, diagnostic_modules)
            valid = false
          } else {
            if !call_valid {
              add_diagnostic(5002, module_id, diagnostic_codes, diagnostic_modules)
              valid = false
            } else {
              hf_dyn_i32_set32(ast_types, node_index, hf_dyn_i32_get32(export_type_ids, export_index))
            }
          }
          }
        }
      }
      }
    }
    node_index = node_index + 1
  }
  return valid
}

