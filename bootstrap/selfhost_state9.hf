  }
  if statement_kind == 13 {
    p9_advance(kinds, cursor)
    let return_value: i32 = p9_parse_expression(kinds, starts, lengths, cursor, node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids, children)
    if return_value < 0 || !p9_expect(kinds, cursor, 41) { return -1 }
    let return_first: i32 = hf_dyn_i32_len32(children)
    hf_dyn_i32_push(children, return_value)
    return p9_node_add(node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids, 5, return_first, 1, 0, 0, hf_dyn_i32_get32(starts, statement_token), p9_token_end(starts, lengths, p9_cursor_index(cursor) - 1), 0, 0)
  }
  return -1
}

fn p9_parse_block(kinds: dyn<i32>, starts: dyn<i32>, lengths: dyn<i32>, cursor: dyn<i32>, node_kinds: dyn<i32>, first_children: dyn<i32>, child_counts: dyn<i32>, name_starts: dyn<i32>, name_lengths: dyn<i32>, span_starts: dyn<i32>, span_ends: dyn<i32>, symbol_ids: dyn<i32>, type_ids: dyn<i32>, children: dyn<i32>) -> i32 {
  let block_start_token: i32 = p9_cursor_index(cursor)
  if !p9_expect(kinds, cursor, 44) { return -1 }
  let block_members: dyn<i32> = hf_dyn_i32_new(128)
  var block_count: i32 = 0
  while p9_current(kinds, cursor) != 45 && p9_current(kinds, cursor) != 0 {
    let statement_node: i32 = p9_parse_statement(kinds, starts, lengths, cursor, node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids, children)
    if statement_node < 0 {
      hf_dyn_i32_free(block_members)
      return -1
    }
    if !hf_dyn_i32_push(block_members, statement_node) {
      hf_dyn_i32_free(block_members)
      return -1
    }
    block_count = block_count + 1
  }
  if !p9_expect(kinds, cursor, 45) {
    hf_dyn_i32_free(block_members)
    return -1
  }
  let block_first: i32 = hf_dyn_i32_len32(children)
  var member_index: i32 = 0
  while member_index < block_count {
    hf_dyn_i32_push(children, hf_dyn_i32_get32(block_members, member_index))
    member_index = member_index + 1
  }
  hf_dyn_i32_free(block_members)
  return p9_node_add(node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids, 3, block_first, block_count, 0, 0, hf_dyn_i32_get32(starts, block_start_token), p9_token_end(starts, lengths, p9_cursor_index(cursor) - 1), 0, 0)
}

fn p9_parse_function(kinds: dyn<i32>, starts: dyn<i32>, lengths: dyn<i32>, cursor: dyn<i32>, node_kinds: dyn<i32>, first_children: dyn<i32>, child_counts: dyn<i32>, name_starts: dyn<i32>, name_lengths: dyn<i32>, span_starts: dyn<i32>, span_ends: dyn<i32>, symbol_ids: dyn<i32>, type_ids: dyn<i32>, children: dyn<i32>) -> i32 {
  let function_start_token: i32 = p9_cursor_index(cursor)
  if !p9_expect(kinds, cursor, 12) { return -1 }
  let function_name_token: i32 = p9_cursor_index(cursor)
  if !p9_expect(kinds, cursor, 100) || !p9_expect(kinds, cursor, 42) { return -1 }
  let parameter_nodes: dyn<i32> = hf_dyn_i32_new(32)
  var parameter_count: i32 = 0
  var parameter_ok: bool = true
  while parameter_ok && p9_current(kinds, cursor) != 43 && p9_current(kinds, cursor) != 0 {
    let parameter_name_token: i32 = p9_cursor_index(cursor)
    if !p9_expect(kinds, cursor, 100) || !p9_expect(kinds, cursor, 40) { parameter_ok = false }
    let parameter_type: i32 = p9_parse_type(kinds, starts, lengths, cursor, node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids)
    if parameter_type < 0 { parameter_ok = false }
    if parameter_ok {
      let parameter_node: i32 = p9_node_add(node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids, 10, 0, 0, hf_dyn_i32_get32(starts, parameter_name_token), hf_dyn_i32_get32(lengths, parameter_name_token), hf_dyn_i32_get32(starts, parameter_name_token), p9_token_end(starts, lengths, p9_cursor_index(cursor) - 1), 0, hf_dyn_i32_get32(type_ids, parameter_type))
      parameter_ok = hf_dyn_i32_push(parameter_nodes, parameter_node)
      parameter_count = parameter_count + 1
      if p9_current(kinds, cursor) == 48 { p9_advance(kinds, cursor) }
    }
  }
  let parameters_closed: bool = parameter_ok && p9_expect(kinds, cursor, 43) && p9_expect(kinds, cursor, 8)
  var function_type: i32 = -1
  if parameters_closed { function_type = p9_parse_type(kinds, starts, lengths, cursor, node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids) }
  if !parameters_closed || function_type < 0 { hf_dyn_i32_free(parameter_nodes); return -1 }
  let function_block: i32 = p9_parse_block(kinds, starts, lengths, cursor, node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids, children)
  if function_block < 0 { hf_dyn_i32_free(parameter_nodes); return -1 }
  let function_first: i32 = hf_dyn_i32_len32(children)
  if !hf_dyn_i32_push(children, function_type) { hf_dyn_i32_free(parameter_nodes); return -1 }
  var parameter_index: i32 = 0
  while parameter_index < parameter_count {
    if !hf_dyn_i32_push(children, hf_dyn_i32_get32(parameter_nodes, parameter_index)) { hf_dyn_i32_free(parameter_nodes); return -1 }
    parameter_index = parameter_index + 1
  }
  if !hf_dyn_i32_push(children, function_block) { hf_dyn_i32_free(parameter_nodes); return -1 }
  hf_dyn_i32_free(parameter_nodes)
  return p9_node_add(node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids, 2, function_first, parameter_count + 2, hf_dyn_i32_get32(starts, function_name_token), hf_dyn_i32_get32(lengths, function_name_token), hf_dyn_i32_get32(starts, function_start_token), hf_dyn_i32_get32(span_ends, function_block), 0, 0)
}

fn p9_parse_program(kinds: dyn<i32>, starts: dyn<i32>, lengths: dyn<i32>, cursor: dyn<i32>, node_kinds: dyn<i32>, first_children: dyn<i32>, child_counts: dyn<i32>, name_starts: dyn<i32>, name_lengths: dyn<i32>, span_starts: dyn<i32>, span_ends: dyn<i32>, symbol_ids: dyn<i32>, type_ids: dyn<i32>, children: dyn<i32>) -> i32 {
  let program_members: dyn<i32> = hf_dyn_i32_new(128)
  var program_count: i32 = 0
  while p9_current(kinds, cursor) != 0 {
    if p9_current(kinds, cursor) == 27 { p9_advance(kinds, cursor) }
    let function_node: i32 = p9_parse_function(kinds, starts, lengths, cursor, node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids, children)
    if function_node < 0 {
      hf_dyn_i32_free(program_members)
      return -1
    }
    if !hf_dyn_i32_push(program_members, function_node) {
      hf_dyn_i32_free(program_members)
      return -1
    }
    program_count = program_count + 1
  }
  let program_first: i32 = hf_dyn_i32_len32(children)
  var function_index: i32 = 0
  while function_index < program_count {
    hf_dyn_i32_push(children, hf_dyn_i32_get32(program_members, function_index))
    function_index = function_index + 1
  }
  hf_dyn_i32_free(program_members)
  return p9_node_add(node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids, 1, program_first, program_count, 0, 0, 0, hf_dyn_i32_len32(starts), 0, 0)
}

fn p9_string_equal(left: string, right: string) -> bool {
  let left_length: i32 = hf_string_len32(left)
  if left_length != hf_string_len32(right) { return false }
  var equal: bool = true
  var equal_index: i32 = 0
  while equal_index < left_length {
    if hf_string_byte32(left, equal_index) != hf_string_byte32(right, equal_index) { equal = false }
    equal_index = equal_index + 1
  }
  return equal
}

fn p9_snapshot(nodes: dyn<i32>, firsts: dyn<i32>, counts: dyn<i32>, name_starts: dyn<i32>, name_lengths: dyn<i32>, spans_start: dyn<i32>, spans_end: dyn<i32>, symbols: dyn<i32>, types: dyn<i32>, children: dyn<i32>) -> string {
  let snapshot_buffer: buf = hf_buf_new(8192)
  var snapshot_index: i32 = 0
  let snapshot_count: i32 = hf_dyn_i32_len32(nodes)
  while snapshot_index < snapshot_count {
    hf_buf_append_i32(snapshot_buffer, hf_dyn_i32_get32(nodes, snapshot_index))
    hf_buf_append_str(snapshot_buffer, ",")
    hf_buf_append_i32(snapshot_buffer, hf_dyn_i32_get32(firsts, snapshot_index))
    hf_buf_append_str(snapshot_buffer, ",")
    hf_buf_append_i32(snapshot_buffer, hf_dyn_i32_get32(counts, snapshot_index))
    hf_buf_append_str(snapshot_buffer, ",")
    hf_buf_append_i32(snapshot_buffer, hf_dyn_i32_get32(name_starts, snapshot_index))
    hf_buf_append_str(snapshot_buffer, ",")
    hf_buf_append_i32(snapshot_buffer, hf_dyn_i32_get32(name_lengths, snapshot_index))
    hf_buf_append_str(snapshot_buffer, ",")
    hf_buf_append_i32(snapshot_buffer, hf_dyn_i32_get32(spans_start, snapshot_index))
    hf_buf_append_str(snapshot_buffer, ",")
    hf_buf_append_i32(snapshot_buffer, hf_dyn_i32_get32(spans_end, snapshot_index))
    hf_buf_append_str(snapshot_buffer, ",")
    hf_buf_append_i32(snapshot_buffer, hf_dyn_i32_get32(symbols, snapshot_index))
    hf_buf_append_str(snapshot_buffer, ",")
    hf_buf_append_i32(snapshot_buffer, hf_dyn_i32_get32(types, snapshot_index))
    hf_buf_append_str(snapshot_buffer, ";")
    snapshot_index = snapshot_index + 1
  }
  hf_buf_append_str(snapshot_buffer, "|")
  snapshot_index = 0
  let snapshot_child_count: i32 = hf_dyn_i32_len32(children)
  while snapshot_index < snapshot_child_count {
    hf_buf_append_i32(snapshot_buffer, hf_dyn_i32_get32(children, snapshot_index))
    hf_buf_append_str(snapshot_buffer, ",")
    snapshot_index = snapshot_index + 1
  }
  let snapshot_result: string = hf_buf_finish(snapshot_buffer)
  hf_buf_free(snapshot_buffer)
  return snapshot_result
}

fn reject_invalid_source() -> bool {
  let bad_source: string = "fn broken() -> i32 { return ; }"
  let bad_kinds: dyn<i32> = hf_dyn_i32_new(64)
  let bad_starts: dyn<i32> = hf_dyn_i32_new(64)
  let bad_lengths: dyn<i32> = hf_dyn_i32_new(64)
  let bad_cursor: dyn<i32> = hf_dyn_i32_new(1)
  hf_dyn_i32_push(bad_cursor, 0)
  let bad_node_kinds: dyn<i32> = hf_dyn_i32_new(64)
  let bad_first_children: dyn<i32> = hf_dyn_i32_new(64)
  let bad_child_counts: dyn<i32> = hf_dyn_i32_new(64)
  let bad_name_starts: dyn<i32> = hf_dyn_i32_new(64)
  let bad_name_lengths: dyn<i32> = hf_dyn_i32_new(64)
  let bad_span_starts: dyn<i32> = hf_dyn_i32_new(64)
  let bad_span_ends: dyn<i32> = hf_dyn_i32_new(64)
  let bad_symbols: dyn<i32> = hf_dyn_i32_new(64)
  let bad_types: dyn<i32> = hf_dyn_i32_new(64)
  let bad_children: dyn<i32> = hf_dyn_i32_new(64)
  let bad_lex: bool = p9_lex(bad_source, bad_kinds, bad_starts, bad_lengths)
  let bad_root: i32 = p9_parse_program(bad_kinds, bad_starts, bad_lengths, bad_cursor, bad_node_kinds, bad_first_children, bad_child_counts, bad_name_starts, bad_name_lengths, bad_span_starts, bad_span_ends, bad_symbols, bad_types, bad_children)
  let rejected: bool = bad_lex && bad_root < 0
  hf_dyn_i32_free(bad_kinds)
  hf_dyn_i32_free(bad_starts)
  hf_dyn_i32_free(bad_lengths)
  hf_dyn_i32_free(bad_cursor)
  hf_dyn_i32_free(bad_node_kinds)
  hf_dyn_i32_free(bad_first_children)
  hf_dyn_i32_free(bad_child_counts)
  hf_dyn_i32_free(bad_name_starts)
  hf_dyn_i32_free(bad_name_lengths)
  hf_dyn_i32_free(bad_span_starts)
  hf_dyn_i32_free(bad_span_ends)
  hf_dyn_i32_free(bad_symbols)
  hf_dyn_i32_free(bad_types)
  hf_dyn_i32_free(bad_children)
  return rejected
}

