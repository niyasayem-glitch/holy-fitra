  hf_dyn_i32_free(rejected_symbol_lengths)
  hf_dyn_i32_free(rejected_symbol_hashes)
  hf_dyn_i32_free(rejected_symbol_scopes)
  hf_dyn_i32_free(rejected_symbol_nodes)
  hf_dyn_i32_free(rejected_symbol_kinds)
  hf_dyn_i32_free(rejected_symbol_types)
  return result
}

