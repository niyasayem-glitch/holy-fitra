  let duplicate_rejected: bool = declare_symbol(source, hf_dyn_i32_get32(node_name_starts, 3), hf_dyn_i32_get32(node_name_lengths, 3), 1, 3, 2, 1, symbol_name_starts, symbol_name_lengths, symbol_hashes, symbol_scopes, symbol_nodes, symbol_kinds, symbol_types) < 0
  let unknown_rejected: bool = reject_semantic_source("fn main() -> i32 { return z; }")
  let type_mismatch_rejected: bool = reject_semantic_source("fn main() -> i32 { var y: bool = 41; return y; }")
  let annotation_shape_ok: bool = hf_dyn_i32_get32(node_symbols, 3) == 2 && hf_dyn_i32_get32(node_symbols, 4) == 2 && hf_dyn_i32_get32(node_types, 4) == 1 && hf_dyn_i32_get32(node_types, 6) == 1 && hf_dyn_i32_get32(node_types, 7) == 1 && hf_dyn_i32_get32(node_types, 9) == 100
  let semantic_snapshot: string = snapshot(node_kinds, first_children, child_counts, node_name_starts, node_name_lengths, node_span_starts, node_span_ends, node_symbols, node_types, children)
  let snapshot_written: bool = hf_write_text("/tmp/holyfitra_state3_semantic.snapshot", semantic_snapshot)
  let persisted_snapshot: string = hf_read_text("/tmp/holyfitra_state3_semantic.snapshot")
  let snapshot_stable: bool = string_equal(semantic_snapshot, persisted_snapshot)
  hf_string_free(persisted_snapshot)
  hf_dyn_i32_free(token_kinds)
  hf_dyn_i32_free(token_starts)
  hf_dyn_i32_free(token_lengths)
  hf_dyn_i32_free(cursor)
  hf_dyn_i32_free(node_kinds)
  hf_dyn_i32_free(first_children)
  hf_dyn_i32_free(child_counts)
  hf_dyn_i32_free(node_name_starts)
  hf_dyn_i32_free(node_name_lengths)
  hf_dyn_i32_free(node_span_starts)
  hf_dyn_i32_free(node_span_ends)
  hf_dyn_i32_free(node_symbols)
  hf_dyn_i32_free(node_types)
  hf_dyn_i32_free(children)
  hf_dyn_i32_free(scope_parents)
  hf_dyn_i32_free(symbol_name_starts)
  hf_dyn_i32_free(symbol_name_lengths)
  hf_dyn_i32_free(symbol_hashes)
  hf_dyn_i32_free(symbol_scopes)
  hf_dyn_i32_free(symbol_nodes)
  hf_dyn_i32_free(symbol_kinds)
  hf_dyn_i32_free(symbol_types)
  hf_string_free(semantic_snapshot)
  if lex_ok && root_node >= 0 && semantic_ok && duplicate_rejected && unknown_rejected && type_mismatch_rejected && annotation_shape_ok && snapshot_written && snapshot_stable { return 0 }
  return 1
}
