  let rejected_symbol_scopes: dyn<i32> = hf_dyn_i32_new(64)
  let rejected_symbol_nodes: dyn<i32> = hf_dyn_i32_new(64)
  let rejected_symbol_kinds: dyn<i32> = hf_dyn_i32_new(64)
  let rejected_symbol_types: dyn<i32> = hf_dyn_i32_new(64)
  let rejected_lex: bool = lex(source, rejected_token_kinds, rejected_token_starts, rejected_token_lengths)
  let rejected_root: i32 = parse_program(rejected_token_kinds, rejected_token_starts, rejected_token_lengths, rejected_cursor, rejected_node_kinds, rejected_first_children, rejected_child_counts, rejected_name_starts, rejected_name_lengths, rejected_span_starts, rejected_span_ends, rejected_symbols, rejected_types, rejected_children)
  let rejected_root_scope: i32 = add_scope(rejected_scope_parents, -1)
  hf_dyn_i32_push(rejected_symbol_starts, 0)
  hf_dyn_i32_push(rejected_symbol_lengths, 0)
  hf_dyn_i32_push(rejected_symbol_hashes, 0)
  hf_dyn_i32_push(rejected_symbol_scopes, -1)
