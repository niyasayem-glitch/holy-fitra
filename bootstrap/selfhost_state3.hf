module selfhost_state2

// State-2 node kinds: module=1, function=2, block=3, declaration=4, return=5,
// integer=6, name=7, binary=8, type=9, parameter=10.

fn is_space(ch: i32) -> bool {
  return ch == 32 || ch == 9 || ch == 10 || ch == 13
}

fn is_digit(ch: i32) -> bool {
  return ch >= 48 && ch <= 57
}

fn is_ident_start(ch: i32) -> bool {
  return (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95
}

fn is_ident_continue(ch: i32) -> bool {
  return is_ident_start(ch) || is_digit(ch)
}

fn keyword(source: string, start: i32, length: i32, word: string, kind: i32) -> bool {
  let word_size: i32 = hf_string_len32(word)
  if start + word_size > length {
    return false
  } else {
    if start + word_size < length && is_ident_continue(hf_string_byte32(source, start + word_size)) {
      return false
    } else {
      var word_index: i32 = 0
      var equal: bool = true
      while word_index < word_size {
        if hf_string_byte32(source, start + word_index) != hf_string_byte32(word, word_index) {
          equal = false
        }
        word_index = word_index + 1
      }
      return equal
    }
  }
}

fn keyword_kind(source: string, start: i32, length: i32) -> i32 {
  if keyword(source, start, length, "module", 10) { return 10 }
  if keyword(source, start, length, "struct", 11) { return 11 }
  if keyword(source, start, length, "fn", 12) { return 12 }
  if keyword(source, start, length, "return", 13) { return 13 }
  if keyword(source, start, length, "if", 14) { return 14 }
  if keyword(source, start, length, "else", 15) { return 15 }
  if keyword(source, start, length, "while", 16) { return 16 }
  if keyword(source, start, length, "true", 17) { return 17 }
  if keyword(source, start, length, "false", 18) { return 18 }
  if keyword(source, start, length, "let", 19) { return 19 }
  if keyword(source, start, length, "var", 20) { return 20 }
  if keyword(source, start, length, "i32", 21) { return 21 }
  if keyword(source, start, length, "i64", 22) { return 22 }
  if keyword(source, start, length, "bool", 23) { return 23 }
  if keyword(source, start, length, "void", 24) { return 24 }
  if keyword(source, start, length, "string", 25) { return 25 }
  if keyword(source, start, length, "dyn", 26) { return 26 }
  return 100
}

fn keyword_length(kind: i32) -> i32 {
  if kind == 10 || kind == 11 || kind == 13 || kind == 25 { return 6 }
  if kind == 12 || kind == 14 { return 2 }
  if kind == 15 { return 4 }
  if kind == 16 { return 5 }
  if kind == 17 { return 4 }
  if kind == 18 { return 5 }
  if kind == 19 || kind == 20 || kind == 21 || kind == 22 || kind == 26 { return 3 }
  if kind == 23 || kind == 24 { return 4 }
  return 0
}

fn single_kind(ch: i32) -> i32 {
  if ch == 58 { return 40 }
  if ch == 59 { return 41 }
  if ch == 40 { return 42 }
  if ch == 41 { return 43 }
  if ch == 123 { return 44 }
  if ch == 125 { return 45 }
  if ch == 44 { return 48 }
  if ch == 61 { return 60 }
  if ch == 43 { return 61 }
  if ch == 45 { return 62 }
  if ch == 42 { return 63 }
  if ch == 47 { return 64 }
  if ch == 60 { return 50 }
  if ch == 62 { return 51 }
  return -1
}

fn push_token(kinds: dyn<i32>, starts: dyn<i32>, lengths: dyn<i32>, kind: i32, start: i32, length: i32) -> bool {
  let pushed_kind: bool = hf_dyn_i32_push(kinds, kind)
  let pushed_start: bool = hf_dyn_i32_push(starts, start)
  let pushed_length: bool = hf_dyn_i32_push(lengths, length)
  return pushed_kind && pushed_start && pushed_length
}

fn lex(source: string, kinds: dyn<i32>, starts: dyn<i32>, lengths: dyn<i32>) -> bool {
  let source_length: i32 = hf_string_len32(source)
  var position: i32 = 0
  var success: bool = true
  while position < source_length {
    let character: i32 = hf_string_byte32(source, position)
    if is_space(character) {
      position = position + 1
    } else {
      if character == 35 {
        while position < source_length && hf_string_byte32(source, position) != 10 {
          position = position + 1
        }
      } else {
        let token_start: i32 = position
        let kind: i32 = keyword_kind(source, position, source_length)
        if kind != 100 {
          let token_size: i32 = keyword_length(kind)
          success = success && push_token(kinds, starts, lengths, kind, token_start, token_size)
          position = position + token_size
        } else {
          if is_digit(character) {
            while position < source_length && is_digit(hf_string_byte32(source, position)) {
              position = position + 1
            }
            success = success && push_token(kinds, starts, lengths, 101, token_start, position - token_start)
          } else {
            if is_ident_start(character) {
              while position < source_length && is_ident_continue(hf_string_byte32(source, position)) {
                position = position + 1
              }
              success = success && push_token(kinds, starts, lengths, 100, token_start, position - token_start)
            } else {
              if character == 34 {
                position = position + 1
                while position < source_length && hf_string_byte32(source, position) != 34 {
                  position = position + 1
                }
                if position < source_length { position = position + 1 }
                success = success && push_token(kinds, starts, lengths, 102, token_start, position - token_start)
              } else {
                if character == 45 && position + 1 < source_length && hf_string_byte32(source, position + 1) == 62 {
                  success = success && push_token(kinds, starts, lengths, 8, token_start, 2)
                  position = position + 2
                } else {
                  if character == 61 && position + 1 < source_length && hf_string_byte32(source, position + 1) == 61 {
                    success = success && push_token(kinds, starts, lengths, 66, token_start, 2)
                    position = position + 2
                  } else {
                    let single: i32 = single_kind(character)
                    if single < 0 {
                      success = false
                    } else {
                      success = success && push_token(kinds, starts, lengths, single, token_start, 1)
                    }
                    position = position + 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  success = success && push_token(kinds, starts, lengths, 0, source_length, 0)
  return success
}

fn current(kinds: dyn<i32>, cursor: dyn<i32>) -> i32 {
  return hf_dyn_i32_get32(kinds, hf_dyn_i32_get32(cursor, 0))
}

fn cursor_index(cursor: dyn<i32>) -> i32 {
  return hf_dyn_i32_get32(cursor, 0)
}

fn advance(kinds: dyn<i32>, cursor: dyn<i32>) -> bool {
  if current(kinds, cursor) == 0 { return false }
  hf_dyn_i32_set32(cursor, 0, cursor_index(cursor) + 1)
  return true
}

fn accept(kinds: dyn<i32>, cursor: dyn<i32>, kind: i32) -> bool {
  if current(kinds, cursor) == kind {
    return advance(kinds, cursor)
  }
  return false
}

fn expect(kinds: dyn<i32>, cursor: dyn<i32>, kind: i32) -> bool {
  return accept(kinds, cursor, kind)
}

fn token_end(starts: dyn<i32>, lengths: dyn<i32>, token_index: i32) -> i32 {
  return hf_dyn_i32_get32(starts, token_index) + hf_dyn_i32_get32(lengths, token_index)
}

fn node_add(node_kinds: dyn<i32>, first_children: dyn<i32>, child_counts: dyn<i32>, name_starts: dyn<i32>, name_lengths: dyn<i32>, span_starts: dyn<i32>, span_ends: dyn<i32>, symbol_ids: dyn<i32>, type_ids: dyn<i32>, kind: i32, first_child: i32, child_count: i32, name_start: i32, name_length: i32, span_start: i32, span_end: i32, symbol_id: i32, type_id: i32) -> i32 {
  let node_id: i32 = hf_dyn_i32_len32(node_kinds)
  hf_dyn_i32_push(node_kinds, kind)
  hf_dyn_i32_push(first_children, first_child)
  hf_dyn_i32_push(child_counts, child_count)
  hf_dyn_i32_push(name_starts, name_start)
  hf_dyn_i32_push(name_lengths, name_length)
  hf_dyn_i32_push(span_starts, span_start)
  hf_dyn_i32_push(span_ends, span_end)
  hf_dyn_i32_push(symbol_ids, symbol_id)
  hf_dyn_i32_push(type_ids, type_id)
  return node_id
}

fn parse_type(kinds: dyn<i32>, starts: dyn<i32>, lengths: dyn<i32>, cursor: dyn<i32>, node_kinds: dyn<i32>, first_children: dyn<i32>, child_counts: dyn<i32>, name_starts: dyn<i32>, name_lengths: dyn<i32>, span_starts: dyn<i32>, span_ends: dyn<i32>, symbol_ids: dyn<i32>, type_ids: dyn<i32>) -> i32 {
  let type_token: i32 = cursor_index(cursor)
  let type_kind: i32 = current(kinds, cursor)
  if type_kind == 21 || type_kind == 22 || type_kind == 23 || type_kind == 24 || type_kind == 25 || type_kind == 100 {
    if !advance(kinds, cursor) { return -1 }
    return node_add(node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids, 9, 0, 0, hf_dyn_i32_get32(starts, type_token), hf_dyn_i32_get32(lengths, type_token), hf_dyn_i32_get32(starts, type_token), token_end(starts, lengths, type_token), 0, type_kind - 20)
  }
  return -1
}

fn parse_primary(kinds: dyn<i32>, starts: dyn<i32>, lengths: dyn<i32>, cursor: dyn<i32>, node_kinds: dyn<i32>, first_children: dyn<i32>, child_counts: dyn<i32>, name_starts: dyn<i32>, name_lengths: dyn<i32>, span_starts: dyn<i32>, span_ends: dyn<i32>, symbol_ids: dyn<i32>, type_ids: dyn<i32>, children: dyn<i32>) -> i32 {
  let primary_token: i32 = cursor_index(cursor)
  let primary_kind: i32 = current(kinds, cursor)
  if primary_kind == 101 {
    if !advance(kinds, cursor) { return -1 }
    return node_add(node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids, 6, 0, 0, 0, 0, hf_dyn_i32_get32(starts, primary_token), token_end(starts, lengths, primary_token), 0, 1)
  }
  if primary_kind == 100 {
    if !advance(kinds, cursor) { return -1 }
    return node_add(node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids, 7, 0, 0, hf_dyn_i32_get32(starts, primary_token), hf_dyn_i32_get32(lengths, primary_token), hf_dyn_i32_get32(starts, primary_token), token_end(starts, lengths, primary_token), 0, 0)
  }
  if accept(kinds, cursor, 42) {
    let nested_node: i32 = parse_primary(kinds, starts, lengths, cursor, node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids, children)
    if nested_node < 0 || !expect(kinds, cursor, 43) { return -1 }
    return nested_node
  }
  return -1
}

fn parse_expression(kinds: dyn<i32>, starts: dyn<i32>, lengths: dyn<i32>, cursor: dyn<i32>, node_kinds: dyn<i32>, first_children: dyn<i32>, child_counts: dyn<i32>, name_starts: dyn<i32>, name_lengths: dyn<i32>, span_starts: dyn<i32>, span_ends: dyn<i32>, symbol_ids: dyn<i32>, type_ids: dyn<i32>, children: dyn<i32>) -> i32 {
  let left_node: i32 = parse_primary(kinds, starts, lengths, cursor, node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids, children)
  if left_node < 0 { return -1 }
  let expression_kind: i32 = current(kinds, cursor)
  if expression_kind == 61 || expression_kind == 62 || expression_kind == 63 || expression_kind == 64 || expression_kind == 66 || expression_kind == 50 || expression_kind == 51 {
    let operator_token: i32 = cursor_index(cursor)
    advance(kinds, cursor)
    let right_node: i32 = parse_primary(kinds, starts, lengths, cursor, node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids, children)
    if right_node < 0 { return -1 }
    let expression_first: i32 = hf_dyn_i32_len32(children)
    hf_dyn_i32_push(children, left_node)
    hf_dyn_i32_push(children, right_node)
    return node_add(node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids, 8, expression_first, 2, 0, 0, hf_dyn_i32_get32(span_starts, left_node), hf_dyn_i32_get32(span_ends, right_node), 0, expression_kind)
  }
  return left_node
}

fn parse_statement(kinds: dyn<i32>, starts: dyn<i32>, lengths: dyn<i32>, cursor: dyn<i32>, node_kinds: dyn<i32>, first_children: dyn<i32>, child_counts: dyn<i32>, name_starts: dyn<i32>, name_lengths: dyn<i32>, span_starts: dyn<i32>, span_ends: dyn<i32>, symbol_ids: dyn<i32>, type_ids: dyn<i32>, children: dyn<i32>) -> i32 {
  let statement_token: i32 = cursor_index(cursor)
  let statement_kind: i32 = current(kinds, cursor)
  if statement_kind == 19 || statement_kind == 20 {
    advance(kinds, cursor)
    let declaration_name_token: i32 = cursor_index(cursor)
    if !expect(kinds, cursor, 100) || !expect(kinds, cursor, 40) { return -1 }
    let declaration_type: i32 = parse_type(kinds, starts, lengths, cursor, node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids)
    if declaration_type < 0 || !expect(kinds, cursor, 60) { return -1 }
    let declaration_value: i32 = parse_expression(kinds, starts, lengths, cursor, node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids, children)
    if declaration_value < 0 || !expect(kinds, cursor, 41) { return -1 }
    let declaration_first: i32 = hf_dyn_i32_len32(children)
    hf_dyn_i32_push(children, declaration_type)
    hf_dyn_i32_push(children, declaration_value)
    return node_add(node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids, 4, declaration_first, 2, hf_dyn_i32_get32(starts, declaration_name_token), hf_dyn_i32_get32(lengths, declaration_name_token), hf_dyn_i32_get32(starts, statement_token), token_end(starts, lengths, cursor_index(cursor) - 1), 0, statement_kind - 18)
  }
  if statement_kind == 13 {
    advance(kinds, cursor)
    let return_value: i32 = parse_expression(kinds, starts, lengths, cursor, node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids, children)
    if return_value < 0 || !expect(kinds, cursor, 41) { return -1 }
    let return_first: i32 = hf_dyn_i32_len32(children)
    hf_dyn_i32_push(children, return_value)
    return node_add(node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids, 5, return_first, 1, 0, 0, hf_dyn_i32_get32(starts, statement_token), token_end(starts, lengths, cursor_index(cursor) - 1), 0, 0)
  }
  return -1
}

fn parse_block(kinds: dyn<i32>, starts: dyn<i32>, lengths: dyn<i32>, cursor: dyn<i32>, node_kinds: dyn<i32>, first_children: dyn<i32>, child_counts: dyn<i32>, name_starts: dyn<i32>, name_lengths: dyn<i32>, span_starts: dyn<i32>, span_ends: dyn<i32>, symbol_ids: dyn<i32>, type_ids: dyn<i32>, children: dyn<i32>) -> i32 {
  let block_start_token: i32 = cursor_index(cursor)
  if !expect(kinds, cursor, 44) { return -1 }
  let block_members: dyn<i32> = hf_dyn_i32_new(128)
  var block_count: i32 = 0
  while current(kinds, cursor) != 45 && current(kinds, cursor) != 0 {
    let statement_node: i32 = parse_statement(kinds, starts, lengths, cursor, node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids, children)
    if statement_node < 0 {
      hf_dyn_i32_free(block_members)
      return -1
    }
    if !hf_dyn_i32_push(block_members, statement_node) {
      hf_dyn_i32_free(block_members)
      return -1
    }
    block_count = block_count + 1
  }
  if !expect(kinds, cursor, 45) {
    hf_dyn_i32_free(block_members)
    return -1
  }
  let block_first: i32 = hf_dyn_i32_len32(children)
  var member_index: i32 = 0
  while member_index < block_count {
    hf_dyn_i32_push(children, hf_dyn_i32_get32(block_members, member_index))
    member_index = member_index + 1
  }
  hf_dyn_i32_free(block_members)
  return node_add(node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids, 3, block_first, block_count, 0, 0, hf_dyn_i32_get32(starts, block_start_token), token_end(starts, lengths, cursor_index(cursor) - 1), 0, 0)
}

fn parse_function(kinds: dyn<i32>, starts: dyn<i32>, lengths: dyn<i32>, cursor: dyn<i32>, node_kinds: dyn<i32>, first_children: dyn<i32>, child_counts: dyn<i32>, name_starts: dyn<i32>, name_lengths: dyn<i32>, span_starts: dyn<i32>, span_ends: dyn<i32>, symbol_ids: dyn<i32>, type_ids: dyn<i32>, children: dyn<i32>) -> i32 {
  let function_start_token: i32 = cursor_index(cursor)
  if !expect(kinds, cursor, 12) { return -1 }
  let function_name_token: i32 = cursor_index(cursor)
  if !expect(kinds, cursor, 100) || !expect(kinds, cursor, 42) || !expect(kinds, cursor, 43) || !expect(kinds, cursor, 8) { return -1 }
  let function_type: i32 = parse_type(kinds, starts, lengths, cursor, node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids)
  if function_type < 0 { return -1 }
  let function_block: i32 = parse_block(kinds, starts, lengths, cursor, node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids, children)
  if function_block < 0 { return -1 }
  let function_first: i32 = hf_dyn_i32_len32(children)
  hf_dyn_i32_push(children, function_type)
  hf_dyn_i32_push(children, function_block)
  return node_add(node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids, 2, function_first, 2, hf_dyn_i32_get32(starts, function_name_token), hf_dyn_i32_get32(lengths, function_name_token), hf_dyn_i32_get32(starts, function_start_token), hf_dyn_i32_get32(span_ends, function_block), 0, 0)
}

fn parse_program(kinds: dyn<i32>, starts: dyn<i32>, lengths: dyn<i32>, cursor: dyn<i32>, node_kinds: dyn<i32>, first_children: dyn<i32>, child_counts: dyn<i32>, name_starts: dyn<i32>, name_lengths: dyn<i32>, span_starts: dyn<i32>, span_ends: dyn<i32>, symbol_ids: dyn<i32>, type_ids: dyn<i32>, children: dyn<i32>) -> i32 {
  let program_members: dyn<i32> = hf_dyn_i32_new(128)
  var program_count: i32 = 0
  while current(kinds, cursor) != 0 {
    let function_node: i32 = parse_function(kinds, starts, lengths, cursor, node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids, children)
    if function_node < 0 {
      hf_dyn_i32_free(program_members)
      return -1
    }
    if !hf_dyn_i32_push(program_members, function_node) {
      hf_dyn_i32_free(program_members)
      return -1
    }
    program_count = program_count + 1
  }
  let program_first: i32 = hf_dyn_i32_len32(children)
  var function_index: i32 = 0
  while function_index < program_count {
    hf_dyn_i32_push(children, hf_dyn_i32_get32(program_members, function_index))
    function_index = function_index + 1
  }
  hf_dyn_i32_free(program_members)
  return node_add(node_kinds, first_children, child_counts, name_starts, name_lengths, span_starts, span_ends, symbol_ids, type_ids, 1, program_first, program_count, 0, 0, 0, hf_dyn_i32_len32(starts), 0, 0)
}

fn string_equal(left: string, right: string) -> bool {
  let left_length: i32 = hf_string_len32(left)
  if left_length != hf_string_len32(right) { return false }
  var equal: bool = true
  var equal_index: i32 = 0
  while equal_index < left_length {
    if hf_string_byte32(left, equal_index) != hf_string_byte32(right, equal_index) { equal = false }
    equal_index = equal_index + 1
  }
  return equal
}

fn snapshot(nodes: dyn<i32>, firsts: dyn<i32>, counts: dyn<i32>, name_starts: dyn<i32>, name_lengths: dyn<i32>, spans_start: dyn<i32>, spans_end: dyn<i32>, symbols: dyn<i32>, types: dyn<i32>, children: dyn<i32>) -> string {
  let snapshot_buffer: buf = hf_buf_new(8192)
  var snapshot_index: i32 = 0
  let snapshot_count: i32 = hf_dyn_i32_len32(nodes)
  while snapshot_index < snapshot_count {
    hf_buf_append_i32(snapshot_buffer, hf_dyn_i32_get32(nodes, snapshot_index))
    hf_buf_append_str(snapshot_buffer, ",")
    hf_buf_append_i32(snapshot_buffer, hf_dyn_i32_get32(firsts, snapshot_index))
    hf_buf_append_str(snapshot_buffer, ",")
    hf_buf_append_i32(snapshot_buffer, hf_dyn_i32_get32(counts, snapshot_index))
    hf_buf_append_str(snapshot_buffer, ",")
    hf_buf_append_i32(snapshot_buffer, hf_dyn_i32_get32(name_starts, snapshot_index))
    hf_buf_append_str(snapshot_buffer, ",")
    hf_buf_append_i32(snapshot_buffer, hf_dyn_i32_get32(name_lengths, snapshot_index))
    hf_buf_append_str(snapshot_buffer, ",")
    hf_buf_append_i32(snapshot_buffer, hf_dyn_i32_get32(spans_start, snapshot_index))
    hf_buf_append_str(snapshot_buffer, ",")
    hf_buf_append_i32(snapshot_buffer, hf_dyn_i32_get32(spans_end, snapshot_index))
    hf_buf_append_str(snapshot_buffer, ",")
    hf_buf_append_i32(snapshot_buffer, hf_dyn_i32_get32(symbols, snapshot_index))
    hf_buf_append_str(snapshot_buffer, ",")
    hf_buf_append_i32(snapshot_buffer, hf_dyn_i32_get32(types, snapshot_index))
    hf_buf_append_str(snapshot_buffer, ";")
    snapshot_index = snapshot_index + 1
  }
  hf_buf_append_str(snapshot_buffer, "|")
  snapshot_index = 0
  let snapshot_child_count: i32 = hf_dyn_i32_len32(children)
  while snapshot_index < snapshot_child_count {
    hf_buf_append_i32(snapshot_buffer, hf_dyn_i32_get32(children, snapshot_index))
    hf_buf_append_str(snapshot_buffer, ",")
    snapshot_index = snapshot_index + 1
  }
  let snapshot_result: string = hf_buf_finish(snapshot_buffer)
  hf_buf_free(snapshot_buffer)
  return snapshot_result
}

fn reject_invalid_source() -> bool {
  let bad_source: string = "fn broken() -> i32 { return ; }"
  let bad_kinds: dyn<i32> = hf_dyn_i32_new(64)
  let bad_starts: dyn<i32> = hf_dyn_i32_new(64)
  let bad_lengths: dyn<i32> = hf_dyn_i32_new(64)
