  let bad_children: dyn<i32> = hf_dyn_i32_new(64)
  let bad_lex: bool = lex(bad_source, bad_kinds, bad_starts, bad_lengths)
  let bad_root: i32 = parse_program(bad_kinds, bad_starts, bad_lengths, bad_cursor, bad_node_kinds, bad_first_children, bad_child_counts, bad_name_starts, bad_name_lengths, bad_span_starts, bad_span_ends, bad_symbols, bad_types, bad_children)
  let rejected: bool = bad_lex && bad_root < 0
  hf_dyn_i32_free(bad_kinds)
  hf_dyn_i32_free(bad_starts)
  hf_dyn_i32_free(bad_lengths)
