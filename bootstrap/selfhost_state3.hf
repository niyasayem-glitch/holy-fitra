  let rejected_function_node: i32 = hf_dyn_i32_get32(rejected_children, hf_dyn_i32_get32(rejected_first_children, rejected_root))
  let rejected_function_symbol: i32 = declare_symbol(source, hf_dyn_i32_get32(rejected_name_starts, rejected_function_node), hf_dyn_i32_get32(rejected_name_lengths, rejected_function_node), rejected_root_scope, rejected_function_node, 1, 100, rejected_symbol_starts, rejected_symbol_lengths, rejected_symbol_hashes, rejected_symbol_scopes, rejected_symbol_nodes, rejected_symbol_kinds, rejected_symbol_types)
  let rejected_semantics: bool = rejected_function_symbol > 0 && annotate_node(source, rejected_root, rejected_root_scope, 0, rejected_node_kinds, rejected_first_children, rejected_child_counts, rejected_name_starts, rejected_name_lengths, rejected_span_starts, rejected_span_ends, rejected_symbols, rejected_types, rejected_children, rejected_scope_parents, rejected_symbol_starts, rejected_symbol_lengths, rejected_symbol_hashes, rejected_symbol_scopes, rejected_symbol_nodes, rejected_symbol_kinds, rejected_symbol_types)
  let result: bool = rejected_lex && rejected_root >= 0 && rejected_function_symbol > 0 && !rejected_semantics
